# Olemasolevad
NEXT_PUBLIC_SUPABASE_URL=https://zjmxbodufagyimpfsjwp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Õpitubade registreerimine (ainult serveris – Vercel -> Settings -> Environment Variables)
SUPABASE_SERVICE_ROLE_KEY=          # Supabase -> Project Settings -> API Keys -> service_role / secret
NEXT_PUBLIC_SITE_URL=https://www.villaveski.ee
WORKSHOP_ADMIN_EMAIL=saaremaalong@gmail.com

# E-kirjade saatmine, VARIANT A: EmailJS (sama konto mis avalehe kontaktivormil).
# EmailJS -> Email Templates -> uus mall: To Email = {{to_email}}, Subject = {{subject}},
# Reply To = {{reply_to}}, sisu (Edit Content -> Code) = {{{html}}}
# EmailJS -> Account -> Security: luba "API calls from non-browser applications".
# Teenus ja avalik võti tulevad olemasolevatest NEXT_PUBLIC_EMAILJS_* muutujatest.
# Kui EMAILJS_HTML_TEMPLATE_ID on seatud, kasutatakse EmailJS-i ja SMTP väljad võib tühjaks jätta.
EMAILJS_HTML_TEMPLATE_ID=
EMAILJS_PRIVATE_KEY=                # ainult kui EmailJS-is on "Use Private Key" sees

# VARIANT B: mistahes SMTP teenus. Soovitus: Resend (tasuta 3000 kirja/kuus),
# domeen villaveski.ee kinnitatakse DNS-kirjetega, klient ei pea midagi tegema.
#   Resend: SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API võti>
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587  SMTP_USER=<Brevo login>  SMTP_PASS=<SMTP võti>
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=<gmail>  SMTP_PASS=<rakenduse parool>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="Sörve Villaveski <opitoad@villaveski.ee>"

# Robotikaitse (valikuline, tasuta: dash.cloudflare.com -> Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
